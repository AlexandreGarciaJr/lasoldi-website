{
  "name": "lasoldi-website",
  "private": true,
  "description": "Site institucional La Soldi Capital. Só a cena 3D das moedas tem build; o resto do site é HTML/CSS/JS puro.",
  "scripts": {
    "build:3d": "node -e \"require('fs').rmSync('assets/js/3d',{recursive:true,force:true})\" && esbuild src/coins/index.js src/lens/index.js --bundle --splitting --format=esm --minify --target=es2020 --legal-comments=none --outbase=src --entry-names=[dir] --chunk-names=three-[hash] --outdir=assets/js/3d",
    "dev": "php -S 127.0.0.1:8088"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.187.0"
  }
}
